\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {UBCA attention structure.} The mask is shown at the block level for illustration. The VLM prefix applies causal self-attention. The 4D Future Expert and World Knowledge Expert use causal self-attention within their own streams and causal cross-attention to each other, forming the bidirectional UBCA pathway. Both streams attend to the VLM prefix, while the Action Expert uses full cross-attention to all three preceding streams and causal self-attention within its own stream. Colors denote causal self-attention, full cross-attention, causal UBCA, and masked connections.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:mask}{{2}{4}{\textbf {UBCA attention structure.} The mask is shown at the block level for illustration. The VLM prefix applies causal self-attention. The 4D Future Expert and World Knowledge Expert use causal self-attention within their own streams and causal cross-attention to each other, forming the bidirectional UBCA pathway. Both streams attend to the VLM prefix, while the Action Expert uses full cross-attention to all three preceding streams and causal self-attention within its own stream. Colors denote causal self-attention, full cross-attention, causal UBCA, and masked connections}{figure.caption.2}{}}
\newlabel{eq:ubca}{{8}{4}{World Knowledge Expert and 4D--2D Alignment}{equation.8}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {4DW-VLA architecture.} Robot state $q_t$ and FK-derived 4D trajectories are patchified, tokenized, and fed into the \textbf  {4D Future Expert}, whose 4D Encoder performs self-attention and cross-attention to the VLM prefix. A shared output head predicts both current and future 7D keypoints ($\mathcal  {L}_{\mathrm  {4D}}$). The resulting tokens $Z^{\mathrm  {4D}}$ are exchanged with the \textbf  {World Knowledge Expert} through \textbf  {UBCA}, producing implicit 2D-foresight tokens $Z^{\mathrm  {wk}}$ that supervise a \textbf  {frozen} video world model during training only. The \textbf  {Action Expert} attends to the VLM, both expert outputs, and generates action chunks ($\mathcal  {L}_{\mathrm  {act}}$). At inference the world model is dropped.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{3}{\textbf {4DW-VLA architecture.} Robot state $q_t$ and FK-derived 4D trajectories are patchified, tokenized, and fed into the \textbf {4D Future Expert}, whose 4D Encoder performs self-attention and cross-attention to the VLM prefix. A shared output head predicts both current and future 7D keypoints ($\mathcal {L}_{\mathrm {4D}}$). The resulting tokens $Z^{\mathrm {4D}}$ are exchanged with the \textbf {World Knowledge Expert} through \textbf {UBCA}, producing implicit 2D-foresight tokens $Z^{\mathrm {wk}}$ that supervise a \textbf {frozen} video world model during training only. The \textbf {Action Expert} attends to the VLM, both expert outputs, and generates action chunks ($\mathcal {L}_{\mathrm {act}}$). At inference the world model is dropped}{figure.caption.1}{}}
\newlabel{eq:action-deploy}{{3}{3}{Problem Formulation}{equation.3}{}}
\newlabel{eq:cur}{{4}{3}{Problem Formulation}{equation.4}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {4DW-VLA overview.} A VLM prefix encodes RGB and language. The \textbf  {4D Future Expert} predicts current and future FK 7D link trajectories. The \textbf  {World Knowledge Expert} predicts implicit 2D-foresight tokens aligned with 4D through \textbf  {UBCA}. A \textbf  {frozen} video world model supervises 2D foresight during training only. The \textbf  {Action Expert} consumes VLM tokens and both experts' outputs. At inference, the world model is dropped.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{3}{\textbf {4DW-VLA overview.} A VLM prefix encodes RGB and language. The \textbf {4D Future Expert} predicts current and future FK 7D link trajectories. The \textbf {World Knowledge Expert} predicts implicit 2D-foresight tokens aligned with 4D through \textbf {UBCA}. A \textbf {frozen} video world model supervises 2D foresight during training only. The \textbf {Action Expert} consumes VLM tokens and both experts' outputs. At inference, the world model is dropped}{figure.caption.1}{}}
\newlabel{eq:lossvid}{{10}{3}{World Knowledge Expert and 4D--2D Alignment}{equation.10}{}}
